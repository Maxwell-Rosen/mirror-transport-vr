artwork = ExtResource("dilation-occupancy")
print_width = 3.25
title = "Which ions feel the slower clock?"
caption = "Blue cells in panel a advance at a reduced rate (β < 1). Orange marks cells where the ion distribution reaches 10% or more of its peak at that axial position. At the mirror throats, compare the share of cells slowed (b) with the share of absolute ion content they hold (c). Across the whole grid, 44.7% of cells slow. They hold just 0.00555% of that content."
credit = "Maxwell Rosen  ·  Thesis figure 5.23  ·  Beam runs, frame 75 at 0.500150 s"

[node name="DilationComparison" type="Node3D" parent="."]
position = Vector3(2.05, 1.67, -25.83)
script = ExtResource("thesis_print")
artwork = ExtResource("dilation-comparison")
print_width = 3.25
title = "What changes when the clocks slow?"
caption = "During full dynamics, one Gkeyll beam run slows the fastest cells (blue dashes). The other keeps every clock at full rate (orange). Compare density, parallel flow and the two ion temperatures after five cycles. Each left half uses a linear scale, each right half a log scale. The median step grew from 0.0526 to 0.526 ns. The ion totals differ by 0.00107%. The runs also used different solver revisions."
credit = "Maxwell Rosen  ·  Thesis figure 5.25  ·  Beam runs, frame 75 at 0.500150 s"
