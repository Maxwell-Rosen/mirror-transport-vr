title = "Which paths reach the wall?"
caption = "Trace the closed loop in position z and parallel velocity v∥. The three o marks sample the same ion at different stages of a bounce. Above the dividing curve, the two t marks follow an ion on its way out. At the bead stand, watch a collision move a bead from a closed ring onto an open path."
credit = "Maxwell Rosen  ·  Thesis figure 3.5  ·  Five-equation model"

[node name="OrbitPhases" type="Node3D" parent="."]
position = Vector3(19.84, 1.65, 2.30)
rotation = Vector3(0, -1.5707963, 0)
script = ExtResource("thesis_print")
artwork = ExtResource("orbit-phases")
print_width = 3.6
title = "When can the calculation skip a bounce?"
caption = "Read the upper pair as trapped ions and the lower pair as escaping ions. The left column follows every bounce. On the right, pseudo-orbit averaging alternates full motion (gray) with intervals that slow the orbit and hold the passing population (white). Follow the flat steps in panel d. Where does escape resume?"
credit = "Maxwell Rosen  ·  Thesis figure 3.6  ·  Five-equation model"
