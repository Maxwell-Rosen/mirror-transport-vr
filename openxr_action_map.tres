[gd_resource type="OpenXRActionMap" format=3 uid="uid://wn4rnb2ud5um"]

[sub_resource type="OpenXRAction" id="Interact"]
resource_name = "interact"
localized_name = "Interact"
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRAction" id="Teleport"]
resource_name = "teleport"
localized_name = "Aim teleport"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRAction" id="PauseMenu"]
resource_name = "pause_menu"
localized_name = "Pause or resume"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRAction" id="AimPose"]
resource_name = "aim_pose"
localized_name = "Aim pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRActionSet" id="MuseumActions"]
resource_name = "museum"
localized_name = "Museum controls"
actions = [SubResource("Interact"), SubResource("Teleport"), SubResource("PauseMenu"), SubResource("AimPose")]

[sub_resource type="OpenXRIPBinding" id="TouchTrigger"]
action = SubResource("Interact")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="TouchThumbstick"]
action = SubResource("Teleport")
binding_path = "/user/hand/right/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="TouchA"]
action = SubResource("PauseMenu")
binding_path = "/user/hand/right/input/a/click"

[sub_resource type="OpenXRIPBinding" id="TouchAim"]
action = SubResource("AimPose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRInteractionProfile" id="Touch"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("TouchTrigger"), SubResource("TouchThumbstick"), SubResource("TouchA"), SubResource("TouchAim")]

[resource]
action_sets = [SubResource("MuseumActions")]
interaction_profiles = [SubResource("Touch")]
